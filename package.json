{
  "name": "questiontree",
  "version": "1.0.0",
  "description": "知识树 - 树形 AI 对话学习工具：把直线聊天变成树形知识图谱，AI 自动提炼分支摘要，越学越深",
  "keywords": [
    "knowledge-tree",
    "ai",
    "llm",
    "chat",
    "learning",
    "study",
    "deepseek",
    "volcengine",
    "ark",
    "react",
    "typescript",
    "vite",
    "express",
    "sqlite"
  ],
  "license": "MIT",
  "author": "Lena",
  "repository": {
    "type": "git",
    "url": "https://github.com/free1101/questiontree.git"
  },
  "homepage": "https://github.com/free1101/questiontree",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true
  }
}
