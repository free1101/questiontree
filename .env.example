# 服务端口
PORT=3000

# 火山方舟 API Key（服务端共用 Key，可留空让用户自行在设置页填写）
# 获取地址：https://console.volcengine.com/ark
ARK_API_KEY=

# 火山方舟 OpenAI 兼容端点
# 套餐(Plan)通道：https://ark.cn-beijing.volces.com/api/plan/v3
# 标准 API Key 通道：https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

# 默认模型 ID（与 StudyWise 一致：火山引擎 DeepSeek；也可填豆包系列或 ep-xxx 接入点）
ARK_MODEL=deepseek-v4-flash
